{
  "name": "markdown-live-render-tables",
  "displayName": "Markdown Live Editor",
  "description": "Obsidian-style live preview and spreadsheet-like table editing for Markdown files in VS Code.",
  "version": "0.1.232",
  "publisher": "dan-homisak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dan-homisak/Markdown_Live_Editor.git"
  },
  "bugs": {
    "url": "https://github.com/dan-homisak/Markdown_Live_Editor/issues"
  },
  "homepage": "https://github.com/dan-homisak/Markdown_Live_Editor#readme",
  "keywords": [
    "markdown",
    "live preview",
    "tables",
    "table editor",
    "wysiwyg",
    "obsidian"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownLiveRenderTables.toggleEditor",
        "title": "Toggle Markdown Live Editor",
        "category": "Markdown Live Editor",
        "icon": "$(eye)"
      },
      {
        "command": "markdownLiveRenderTables.showDebugLog",
        "title": "Show Debug Log",
        "category": "Markdown Live Editor"
      },
      {
        "command": "markdownLiveRenderTables.toggleTaskCheckbox",
        "title": "Toggle Task Checkbox at Caret",
        "category": "Markdown Live Editor",
        "enablement": "activeCustomEditorId == markdownLiveRenderTables.liveEditor && config.markdownLiveRenderTables.markdownRendering.enabled"
      },
      {
        "command": "markdownLiveRenderTables.openMarkdownLinkAtCaret",
        "title": "Open Markdown Link at Caret",
        "category": "Markdown Live Editor",
        "enablement": "activeCustomEditorId == markdownLiveRenderTables.liveEditor && config.markdownLiveRenderTables.markdownRendering.enabled"
      },
      {
        "command": "markdownLiveRenderTables.focusTaskCheckbox",
        "title": "Focus Task Checkbox at Caret",
        "category": "Markdown Live Editor",
        "enablement": "activeCustomEditorId == markdownLiveRenderTables.liveEditor && config.markdownLiveRenderTables.markdownRendering.enabled"
      },
      {
        "command": "markdownLiveRenderTables.undo",
        "title": "Undo",
        "category": "Markdown Live Editor",
        "icon": "$(arrow-left)",
        "enablement": "activeCustomEditorId == markdownLiveRenderTables.liveEditor && markdownLiveRenderTables.canUndo"
      },
      {
        "command": "markdownLiveRenderTables.redo",
        "title": "Redo",
        "category": "Markdown Live Editor",
        "icon": "$(arrow-right)",
        "enablement": "activeCustomEditorId == markdownLiveRenderTables.liveEditor && markdownLiveRenderTables.canRedo"
      }
    ],
    "keybindings": [
      {
        "command": "markdownLiveRenderTables.toggleEditor",
        "key": "ctrl+alt+m",
        "mac": "cmd+ctrl+m"
      }
    ],
    "configuration": {
      "title": "Markdown Live Editor",
      "properties": {
        "markdownLiveRenderTables.lineHighlight.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Highlight the active line outside rendered tables in the Markdown Live Editor. Table highlighting and editing are unchanged."
        },
        "markdownLiveRenderTables.occurrenceHighlight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Highlight other occurrences of the word at the caret, or of the selected text, throughout the document (including rendered table cells), like VS Code. Uses the theme's selection highlight color."
        },
        "markdownLiveRenderTables.debug": {
          "type": "boolean",
          "default": false,
          "description": "Write live editor cursor, focus, and source edit diagnostics to the Markdown Live Editor output channel."
        },
        "markdownLiveRenderTables.tableNavigation.modifierKey": {
          "type": "string",
          "scope": "window",
          "default": "F2",
          "markdownDescription": "Key or combination to hold while pressing an arrow key to move to an adjacent rendered table cell. Examples: `F2`, `Control`, `Alt+Shift`, `Ctrl+Space`, `KeyQ`, `Numpad0`. Accepts keyboard key/code names; the chosen key is reserved while editing cells."
        },
        "markdownLiveRenderTables.clipboard.defaultCopyMode": {
          "type": "string",
          "enum": [
            "smart",
            "rich",
            "plain",
            "markdown"
          ],
          "default": "smart",
          "description": "Default representation used by Copy in the Markdown Live Editor. Smart keeps lists inside spreadsheet cells; Rich preserves semantic lists for word processors."
        },
        "markdownLiveRenderTables.clipboard.defaultPasteMode": {
          "type": "string",
          "enum": [
            "auto",
            "rich",
            "plain",
            "markdown"
          ],
          "default": "auto",
          "description": "Default interpretation used by Paste in the Markdown Live Editor. Automatic prefers lossless internal data, then HTML, Markdown, and plain text."
        },
        "markdownLiveRenderTables.markdownRendering.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use Obsidian-style Live Preview: hide inactive Markdown syntax, reveal it at the caret, render properties/callouts/code, and enable task, list, and link controls. Disable to restore ordinary non-table source editing; rendered tables remain available."
        },
        "markdownLiveRenderTables.markdownRendering.showHeadingMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Always show heading # markers in the Markdown Live Editor. Disable to hide them in inactive headings and reveal them while editing. Heading colors and text size are preserved."
        },
        "markdownLiveRenderTables.tableShortcuts.insertRowBelow": {
          "type": "string",
          "default": "Ctrl+Enter",
          "markdownDescription": "Shortcut to insert a row below while editing a table cell. Use modifiers plus a keyboard key/code (for example `Ctrl+Enter` or `Alt+KeyR`). Set to an empty string to disable."
        },
        "markdownLiveRenderTables.tableShortcuts.insertRowAbove": {
          "type": "string",
          "default": "Ctrl+Shift+Enter",
          "markdownDescription": "Shortcut to insert a row above while editing a table cell. Use modifiers plus a keyboard key/code (for example `Ctrl+Enter` or `Alt+KeyR`). Set to an empty string to disable."
        },
        "markdownLiveRenderTables.tableShortcuts.insertColumnRight": {
          "type": "string",
          "default": "Alt+Enter",
          "markdownDescription": "Shortcut to insert a column right while editing a table cell. Use modifiers plus a keyboard key/code (for example `Ctrl+Enter` or `Alt+KeyR`). Set to an empty string to disable."
        },
        "markdownLiveRenderTables.tableShortcuts.insertColumnLeft": {
          "type": "string",
          "default": "Alt+Shift+Enter",
          "markdownDescription": "Shortcut to insert a column left while editing a table cell. Use modifiers plus a keyboard key/code (for example `Ctrl+Enter` or `Alt+KeyR`). Set to an empty string to disable."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "markdownLiveRenderTables.liveEditor",
        "displayName": "Markdown Live Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownLiveRenderTables.toggleEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        },
        {
          "command": "markdownLiveRenderTables.undo",
          "when": "activeCustomEditorId == markdownLiveRenderTables.liveEditor",
          "group": "navigation@2"
        },
        {
          "command": "markdownLiveRenderTables.redo",
          "when": "activeCustomEditorId == markdownLiveRenderTables.liveEditor",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run bundle:webview && npm run bundle:extension",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "tsc -watch -p ./",
    "bundle:webview": "esbuild ./src/webview/liveEditor.ts --bundle --minify-syntax --minify-whitespace --format=iife --platform=browser --target=es2022 --outfile=./media/liveEditor.js",
    "bundle:extension": "esbuild ./src/extension.ts --bundle --format=cjs --platform=node --target=node20 --external:vscode --sourcemap --outfile=./dist/extension.js && node scripts/copy-syntax-assets.mjs",
    "pretest": "node -e \"require('fs').rmSync('dist/test',{recursive:true,force:true})\" && npm run compile",
    "test": "npm run test:unit && npm run test:bundle",
    "test:unit": "node --test \"dist/test/*.test.js\"",
    "test:bundle": "node scripts/check-extension-bundle.mjs && node scripts/check-markdown-host-lifecycle.mjs",
    "test:host": "npm run compile && node scripts/edh-visual-check.mjs",
    "test:host:preview": "npm run compile && node scripts/edh-markdown-release-check.mjs --live-preview-only",
    "test:host:rendering": "npm run compile && node scripts/edh-markdown-rendering-check.mjs",
    "test:host:release": "npm run compile && node scripts/edh-markdown-release-check.mjs",
    "test:host:highlighting": "npm run compile && node scripts/edh-code-highlighting-check.mjs",
    "test:host:structure": "npm run compile && node scripts/edh-structure-controls-check.mjs",
    "test:host:toggle": "npm run compile && node scripts/edh-toggle-check.mjs",
    "test:agent": "node --test .claude/hooks/hooks.test.mjs scripts/check-docs.test.mjs scripts/check-privacy.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "test:all": "npm test && npm run check:docs && npm run check:privacy && npm run test:agent && node scripts/edh-visual-check.mjs && node scripts/edh-structure-controls-check.mjs && node scripts/edh-toggle-check.mjs && node scripts/edh-markdown-rendering-check.mjs && node scripts/edh-markdown-release-check.mjs",
    "harness": "npm run compile && node scripts/render-live-editor-harness.mjs",
    "fixtures:manifest": "node scripts/update-fixture-manifest.mjs",
    "fixtures:gutter": "node scripts/generate-gutter-stress-fixture.mjs && node scripts/update-fixture-manifest.mjs",
    "package": "vsce package --out markdown-live-render-tables-latest.vsix",
    "package:windows": "npm run package && node scripts/prepare-windows-install-bundle.mjs",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.8",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3",
    "undici": "7.28.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/lint": "6.9.7",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.6.4",
    "dompurify": "^3.4.11",
    "jsonc-parser": "3.3.1",
    "markdown-it": "^14.3.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "yaml": "2.8.3"
  }
}
